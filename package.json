{
  "name": "block-reference-interpreter",
  "displayName": "%blockReferenceInterpreter.displayName%",
  "description": "%blockReferenceInterpreter.description%",
  "version": "0.5.2",
  "publisher": "louis-15",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Louis-15/block-reference-interpreter.git"
  },
  "homepage": "https://github.com/Louis-15/block-reference-interpreter#readme",
  "bugs": {
    "url": "https://github.com/Louis-15/block-reference-interpreter/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tine",
    "logseq",
    "block reference",
    "块引用",
    "copilot"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "contributes": {
    "languageModelTools": [
      {
        "name": "tineBlockRef_readBlock",
        "displayName": "%tineBlockRef_readBlock.displayName%",
        "userDescription": "%tineBlockRef_readBlock.userDescription%",
        "modelDescription": "%tineBlockRef_readBlock.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "blockRef",
        "icon": "$(references)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "blockIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "%tineBlockRef_readBlock.blockIds.description%"
            },
            "includeChildren": {
              "type": "boolean",
              "description": "%tineBlockRef_readBlock.includeChildren.description%"
            },
            "compact": {
              "type": "boolean",
              "description": "%tineBlockRef_readBlock.compact.description%"
            },
            "maxDepth": {
              "type": "number",
              "description": "%tineBlockRef_readBlock.maxDepth.description%"
            }
          },
          "required": [
            "blockIds"
          ]
        }
      },
      {
        "name": "tineBlockRef_readNote",
        "displayName": "%tineBlockRef_readNote.displayName%",
        "userDescription": "%tineBlockRef_readNote.userDescription%",
        "modelDescription": "%tineBlockRef_readNote.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "blockNote",
        "icon": "$(book)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "%tineBlockRef_readNote.filePath.description%"
            },
            "mode": {
              "type": "string",
              "enum": [
                "expand",
                "list",
                "both"
              ],
              "description": "%tineBlockRef_readNote.mode.description%"
            },
            "includeChildren": {
              "type": "boolean",
              "description": "%tineBlockRef_readNote.includeChildren.description%"
            },
            "maxDepth": {
              "type": "number",
              "description": "%tineBlockRef_readNote.maxDepth.description%"
            }
          },
          "required": [
            "filePath"
          ]
        }
      },
      {
        "name": "tineBlockRef_findBacklinks",
        "displayName": "%tineBlockRef_findBacklinks.displayName%",
        "userDescription": "%tineBlockRef_findBacklinks.userDescription%",
        "modelDescription": "%tineBlockRef_findBacklinks.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "blockBacklinks",
        "icon": "$(link)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "blockId": {
              "type": "string",
              "description": "%tineBlockRef_findBacklinks.blockId.description%"
            },
            "limit": {
              "type": "number",
              "description": "%tineBlockRef_findBacklinks.limit.description%"
            }
          },
          "required": [
            "blockId"
          ]
        }
      },
      {
        "name": "tineBlockRef_newId",
        "displayName": "%tineBlockRef_newId.displayName%",
        "userDescription": "%tineBlockRef_newId.userDescription%",
        "modelDescription": "%tineBlockRef_newId.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "blockNewId",
        "icon": "$(key)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "count": {
              "type": "number",
              "description": "%tineBlockRef_newId.count.description%"
            },
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "%tineBlockRef_newId.labels.description%"
            }
          }
        }
      },
      {
        "name": "tineBlockRef_findBlocks",
        "displayName": "%tineBlockRef_findBlocks.displayName%",
        "userDescription": "%tineBlockRef_findBlocks.userDescription%",
        "modelDescription": "%tineBlockRef_findBlocks.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "blockFind",
        "icon": "$(search)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "%tineBlockRef_findBlocks.query.description%"
            },
            "filePath": {
              "type": "string",
              "description": "%tineBlockRef_findBlocks.filePath.description%"
            },
            "limit": {
              "type": "number",
              "description": "%tineBlockRef_findBlocks.limit.description%"
            },
            "includeContent": {
              "type": "boolean",
              "description": "%tineBlockRef_findBlocks.includeContent.description%"
            },
            "headingsOnly": {
              "type": "boolean",
              "description": "%tineBlockRef_findBlocks.headingsOnly.description%"
            },
            "headingLevel": {
              "type": "number",
              "description": "%tineBlockRef_findBlocks.headingLevel.description%"
            }
          }
        }
      },
      {
        "name": "tineBlockRef_makeRef",
        "displayName": "%tineBlockRef_makeRef.displayName%",
        "userDescription": "%tineBlockRef_makeRef.userDescription%",
        "modelDescription": "%tineBlockRef_makeRef.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "blockMakeRef",
        "icon": "$(link)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "%tineBlockRef_makeRef.filePath.description%"
            },
            "line": {
              "type": "number",
              "description": "%tineBlockRef_makeRef.line.description%"
            },
            "expectedFirstLine": {
              "type": "string",
              "description": "%tineBlockRef_makeRef.expectedFirstLine.description%"
            },
            "kind": {
              "type": "string",
              "enum": [
                "inline",
                "embed"
              ],
              "description": "%tineBlockRef_makeRef.kind.description%"
            }
          },
          "required": [
            "filePath",
            "line",
            "expectedFirstLine"
          ]
        }
      },
      {
        "name": "tineBlockRef_link",
        "displayName": "%tineBlockRef_link.displayName%",
        "userDescription": "%tineBlockRef_link.userDescription%",
        "modelDescription": "%tineBlockRef_link.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "blockLink",
        "icon": "$(link)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "%tineBlockRef_link.filePath.description%"
            },
            "destination": {
              "type": "object",
              "description": "%tineBlockRef_link.destination.description%",
              "properties": {
                "filePath": {
                  "type": "string",
                  "description": "%tineBlockRef_link.destination.filePath.description%"
                },
                "line": {
                  "type": "number",
                  "description": "%tineBlockRef_link.destination.line.description%"
                },
                "expectedFirstLine": {
                  "type": "string",
                  "description": "%tineBlockRef_link.destination.expectedFirstLine.description%"
                },
                "position": {
                  "type": "string",
                  "enum": ["child", "sibling"],
                  "description": "%tineBlockRef_link.destination.position.description%"
                }
              },
              "required": [
                "filePath",
                "line",
                "expectedFirstLine"
              ]
            },
            "targets": {
              "type": "array",
              "description": "%tineBlockRef_link.targets.description%",
              "items": {
                "type": "object",
                "properties": {
                  "filePath": {
                    "type": "string",
                    "description": "%tineBlockRef_link.targets.filePath.description%"
                  },
                  "line": {
                    "type": "number",
                    "description": "%tineBlockRef_link.targets.line.description%"
                  },
                  "expectedFirstLine": {
                    "type": "string",
                    "description": "%tineBlockRef_link.targets.expectedFirstLine.description%"
                  },
                  "label": {
                    "type": "string",
                    "description": "%tineBlockRef_link.targets.label.description%"
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["inline", "embed"],
                    "description": "%tineBlockRef_link.targets.kind.description%"
                  }
                },
                "required": [
                  "line",
                  "expectedFirstLine"
                ]
              }
            }
          },
          "required": [
            "destination",
            "targets"
          ]
        }
      },
      {
        "name": "tineBlockRef_checkRefs",
        "displayName": "%tineBlockRef_checkRefs.displayName%",
        "userDescription": "%tineBlockRef_checkRefs.userDescription%",
        "modelDescription": "%tineBlockRef_checkRefs.modelDescription%",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "blockCheck",
        "icon": "$(checklist)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "%tineBlockRef_checkRefs.filePath.description%"
            },
            "blockIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "%tineBlockRef_checkRefs.blockIds.description%"
            }
          },
          "required": [
            "filePath"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "blockReferenceInterpreter.expandCurrentNote",
        "title": "%blockReferenceInterpreter.command.expandCurrentNote%"
      },
      {
        "command": "blockReferenceInterpreter.expandBlockAtCursor",
        "title": "%blockReferenceInterpreter.command.expandBlockAtCursor%"
      },
      {
        "command": "blockReferenceInterpreter.expandBlockById",
        "title": "%blockReferenceInterpreter.command.expandBlockById%"
      },
      {
        "command": "blockReferenceInterpreter.showBacklinksAtCursor",
        "title": "%blockReferenceInterpreter.command.showBacklinksAtCursor%"
      },
      {
        "command": "blockReferenceInterpreter.showBacklinks",
        "title": "%blockReferenceInterpreter.command.showBacklinks%"
      },
      {
        "command": "blockReferenceInterpreter.showBacklinksPanel",
        "title": "%blockReferenceInterpreter.command.showBacklinksPanel%"
      },
      {
        "command": "blockReferenceInterpreter.rebuildIndex",
        "title": "%blockReferenceInterpreter.command.rebuildIndex%"
      },
      {
        "command": "blockReferenceInterpreter.selectGraphRoot",
        "title": "%blockReferenceInterpreter.command.selectGraphRoot%"
      },
      {
        "command": "blockReferenceInterpreter.showLog",
        "title": "%blockReferenceInterpreter.command.showLog%"
      },
      {
        "command": "blockReferenceInterpreter.copyBlockReference",
        "title": "%blockReferenceInterpreter.command.copyBlockReference%"
      },
      {
        "command": "blockReferenceInterpreter.copyBlockEmbed",
        "title": "%blockReferenceInterpreter.command.copyBlockEmbed%"
      },
      {
        "command": "blockReferenceInterpreter.insertSoftBreak",
        "title": "%blockReferenceInterpreter.command.insertSoftBreak%"
      },
      {
        "command": "blockReferenceInterpreter.enterInBlock",
        "title": "%blockReferenceInterpreter.command.enterInBlock%"
      }
    ],
    "keybindings": [
      {
        "command": "blockReferenceInterpreter.enterInBlock",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !inlineSuggestionVisible"
      },
      {
        "command": "blockReferenceInterpreter.insertSoftBreak",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == markdown && !editorHasSelection && !suggestWidgetVisible && !inSnippetMode"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "blockReferenceInterpreter.copyBlockReference",
          "when": "editorLangId == markdown",
          "group": "blockReference@1"
        },
        {
          "command": "blockReferenceInterpreter.copyBlockEmbed",
          "when": "editorLangId == markdown",
          "group": "blockReference@2"
        }
      ]
    },
    "configuration": {
      "title": "%blockReferenceInterpreter.configuration.title%",
      "properties": {
        "tineBlockRef.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-cn"
          ],
          "enumDescriptions": [
            "%tineBlockRef.language.enum.auto%",
            "%tineBlockRef.language.enum.en%",
            "%tineBlockRef.language.enum.zh-cn%"
          ],
          "default": "auto",
          "description": "%tineBlockRef.language%"
        },
        "tineBlockRef.graphRoot": {
          "type": "string",
          "default": "",
          "description": "%tineBlockRef.graphRoot%"
        },
        "tineBlockRef.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "pages/**/*.md",
            "journals/**/*.md"
          ],
          "description": "%tineBlockRef.include%"
        },
        "tineBlockRef.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "logseq/**",
            ".tine-trash/**",
            "**/bak/**",
            "**/.recycle/**",
            "**/node_modules/**",
            "**/.git/**"
          ],
          "description": "%tineBlockRef.exclude%"
        },
        "tineBlockRef.maxDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "%tineBlockRef.maxDepth%"
        },
        "tineBlockRef.maxOutputChars": {
          "type": "number",
          "default": 20000,
          "minimum": 1000,
          "description": "%tineBlockRef.maxOutputChars%"
        },
        "tineBlockRef.hoverPreviewLines": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "description": "%tineBlockRef.hoverPreviewLines%"
        },
        "tineBlockRef.hideProperties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "id",
            "collapsed"
          ],
          "description": "%tineBlockRef.hideProperties%"
        },
        "tineBlockRef.inlineRender.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%tineBlockRef.inlineRender.enabled%"
        },
        "tineBlockRef.inlineRender.mode": {
          "type": "string",
          "enum": [
            "activeLine",
            "replace",
            "append"
          ],
          "enumDescriptions": [
            "%tineBlockRef.inlineRender.mode.enum.activeLine%",
            "%tineBlockRef.inlineRender.mode.enum.replace%",
            "%tineBlockRef.inlineRender.mode.enum.append%"
          ],
          "default": "activeLine",
          "description": "%tineBlockRef.inlineRender.mode%"
        },
        "tineBlockRef.enterSplitBlock": {
          "type": "boolean",
          "default": true,
          "description": "%tineBlockRef.enterSplitBlock%"
        },
        "tineBlockRef.inlineRender.maxTitleLength": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "%tineBlockRef.inlineRender.maxTitleLength%"
        },
        "tineBlockRef.inlineRender.showMissing": {
          "type": "boolean",
          "default": true,
          "description": "%tineBlockRef.inlineRender.showMissing%"
        },
        "tineBlockRef.render.stripHeadingMarks": {
          "type": "boolean",
          "default": true,
          "description": "%tineBlockRef.render.stripHeadingMarks%"
        },
        "tineBlockRef.showIndexNotification": {
          "type": "boolean",
          "default": true,
          "description": "%tineBlockRef.showIndexNotification%"
        },
        "tineBlockRef.backlinks.style": {
          "type": "string",
          "enum": [
            "inline",
            "lens",
            "off"
          ],
          "enumDescriptions": [
            "%tineBlockRef.backlinks.style.enum.inline%",
            "%tineBlockRef.backlinks.style.enum.lens%",
            "%tineBlockRef.backlinks.style.enum.off%"
          ],
          "default": "inline",
          "description": "%tineBlockRef.backlinks.style%"
        },
        "tineBlockRef.backlinks.panel": {
          "type": "string",
          "enum": [
            "html",
            "text"
          ],
          "enumDescriptions": [
            "%tineBlockRef.backlinks.panel.enum.html%",
            "%tineBlockRef.backlinks.panel.enum.text%"
          ],
          "default": "html",
          "description": "%tineBlockRef.backlinks.panel%"
        },
        "tineBlockRef.backlinks.subtreeLines": {
          "type": "number",
          "default": 0,
          "description": "%tineBlockRef.backlinks.subtreeLines%",
          "minimum": 0,
          "maximum": 2000
        },
        "tineBlockRef.backlinks.itemsPerPage": {
          "type": "number",
          "default": 20,
          "description": "%tineBlockRef.backlinks.itemsPerPage%",
          "minimum": 1,
          "maximum": 500
        },
        "tineBlockRef.backlinks.pathDepth": {
          "type": "number",
          "default": 3,
          "description": "%tineBlockRef.backlinks.pathDepth%",
          "minimum": 0,
          "maximum": 10
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
